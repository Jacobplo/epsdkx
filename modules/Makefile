CMSIS_5 := $(MODULE_DIR)/CMSIS_5
mod-$(CONFIG_MODULE_CMSIS_5) += $(CMSIS_5)/.git
inc-$(CONFIG_MODULE_CMSIS_5) += -I$(CMSIS_5)/CMSIS/Core/Include

